# Copy to .env and adjust. .env is gitignored.
# Image tag: CI publishes :edge from main and :X.Y.Z from version tags.
OOO_IMAGE=ghcr.io/entrhopi/sogo-vacation-addin:edge

# Docker network holding the mailcow services (aliases: sogo, dovecot).
# Find it with: docker network ls | grep -i mailcow
MAILCOW_NETWORK=mailcow_mailcow-network

# Origin the Outlook add-in is served from. Must match exactly, no trailing slash.
ADDIN_ORIGINS=https://mail.example.org

# Dovecot presents the certificate of the public mail hostname while this
# container connects to the internal "dovecot" alias. Set this to that public
# hostname so the certificate chain is verified rather than switching
# verification off.
IMAP_TLS_SERVERNAME=mail.example.org
# Only set to "false" when Dovecot uses a certificate no public CA issued.
IMAP_TLS_REJECT_UNAUTHORIZED=true

# Public URL the app is served from, without a trailing slash. Must match the
# Traefik rule below. Without it /manifest.xml returns 404 (the web app itself
# still works, only the optional Outlook wrapper is unavailable).
PUBLIC_BASE_URL=https://mail.example.org/ooo

# Host for the Traefik router. The public hostname only, used in Host(...).
PUBLIC_HOST=mail.example.org

# Traefik wiring. Check these three against your Traefik config:
#   docker inspect traefik_app --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
#   entrypoint and resolver names live in Traefik's static configuration.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Mailbox credentials are never configured here: they arrive per request
# from the add-in and are verified against Dovecot before every write.
