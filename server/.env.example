# Copy to .env for local development. .env is gitignored.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API from a browser.
# This is the origin the Outlook add-in taskpane is served from.
ADDIN_ORIGINS=https://localhost:5173

# SOGo inside the mailcow network. The public /SOGo route cannot be used:
# nginx overwrites the proxy-auth headers with its own session check.
SOGO_BASE_URL=http://sogo:20000
SOGO_TIMEOUT_MS=5000

# Dovecot, used to verify the mailbox password before SOGo is touched.
# SOGo trusts the proxy header and does not check passwords itself.
IMAP_HOST=dovecot
IMAP_PORT=993
IMAP_SECURITY=tls
IMAP_TIMEOUT_MS=5000
